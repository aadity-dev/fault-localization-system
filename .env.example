# Environment variables for fault-localization-system
# Copy this to .env and fill in the values.

# --- Required (used by docker-compose) ---
POSTGRES_DB=gridfault
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin

# --- Backend ---
DATABASE_URL=postgresql://admin:admin@db:5432/gridfault
REDIS_URL=redis://redis:6379

# --- Optional: AI ticket summary (Gemini) ---
# Set this to enable AI-generated plain-language ticket summaries.
# Without it the system falls back to a deterministic template summary
# automatically -- no feature is broken by its absence.
GEMINI_API_KEY=
